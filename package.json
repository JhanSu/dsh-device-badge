{
  "name": "dsh-device-badge",
  "version": "1.0.3",
  "private": false,
  "type": "module",
  "description": "Shows the machine DSH runs on in the sidebar account row: laptops get the model, battery percentage and a macOS-style charging glyph; iMac, Mac mini, Windows desktops and NAS boxes get their own outlined device icon.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "device",
    "badge",
    "sidebar",
    "battery",
    "macos",
    "nas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JhanSu/dsh-device-badge.git"
  },
  "homepage": "https://github.com/JhanSu/dsh-device-badge"
}
